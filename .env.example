# ===========================================
# Taskora Environment Variables
# ===========================================

# Application
NUXT_PUBLIC_APP_NAME=Taskbir
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication / Session Secret (minimal 32 karakter acak untuk produksi)
NUXT_SESSION_SECRET=replace-with-a-secure-random-string-at-least-32-chars

# TiDB Database Configuration (MySQL-compatible)
# Opsi 1: Gunakan DATABASE_URL (direkomendasikan untuk TiDB Cloud)
# Format: mysql://<user>:<password>@<host>:4000/<database>
DATABASE_URL=mysql://root:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/taskora

# Opsi 2: Atau gunakan variabel terpisah (fallback jika DATABASE_URL kosong)
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=taskora

# SSL / TLS untuk TiDB Cloud (true untuk TiDB Cloud, false untuk TiDB lokal tanpa TLS)
TIDB_SSL=true
TIDB_SSL_CA_PATH=
